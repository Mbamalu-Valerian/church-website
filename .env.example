# Dominus API
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./server/data/dominus.sqlite
# Azure App Service (Linux): /home/data/dominus.sqlite
# DATABASE_PATH=/home/data/dominus.sqlite
SESSION_SECRET=replace-with-a-long-random-secret
DOMINUS_USERNAME=dominus01
DOMINUS_PASSWORD=replace-with-a-unique-strong-password

# Media storage (photos, videos, and Vault PDF publications)
# -----------------------------------------------------------
# Default: Host Persistent Disk Storage
# Zero setup required! Files are stored directly on the persistent host disk (e.g. /home/data/uploads on Azure).
# Videos stream natively with HTTP Range support.
# Optional override path:
# STORAGE_DISK_PATH=/home/data/uploads

# Alternative Cloud Options (Optional):
# -------------------------------------
# Supabase Storage:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Azure Blob Storage:
# AZURE_STORAGE_CONNECTION_STRING=

# Cloudflare R2:
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Gmail (for The Rosarian monthly parish newsletter)
# --------------------------------------------------
# GMAIL_USER=parish@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop
# PUBLIC_SITE_URL=https://hrccw.com.ng
