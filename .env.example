# Dominus API
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./server/data/dominus.sqlite
# Azure App Service (Linux): /home/data/dominus.sqlite
# DATABASE_PATH=/home/data/dominus.sqlite
SESSION_SECRET=replace-with-a-long-random-secret
DOMINUS_USERNAME=dominus01
DOMINUS_PASSWORD=replace-with-a-unique-strong-password

# Media storage (required for new gallery photos/videos and PDF publications)
# ---------------------------------------------------------------------------
# Option 1: Supabase Storage (Recommended: free tier, 1 GB storage, no credit card required)
# In Supabase: Project Settings > API > copy Project URL and service_role secret key
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# SUPABASE_BUCKET=dominus-media

# Option 2: Azure Blob Storage
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=dominus-media

# Option 3: Cloudflare R2
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Gmail (for The Rosarian monthly parish newsletter)
# --------------------------------------------------
# GMAIL_USER=parish@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop
# PUBLIC_SITE_URL=https://yourdomain.com
