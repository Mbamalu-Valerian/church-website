# Dominus API
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./server/data/dominus.sqlite
SESSION_SECRET=replace-with-a-long-random-secret
DOMINUS_USERNAME=dominus
DOMINUS_PASSWORD=replace-with-a-unique-password
# Use either a direct JSON endpoint or the public Universalis calendar page.
# The script supports both API-style JSON and scraped HTML pages.
UNIVERSALIS_API_URL=
UNIVERSALIS_SCRAPE_URL=https://universalis.com/today.htm
# If neither is set, the script falls back to the default public page and then to the local cached calendar data.
